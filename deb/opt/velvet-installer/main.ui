<?xml version="1.0" encoding="UTF-8"?>
<interface>
    <object class="GtkStack" id="content_box">
        <property name="transition-type">GTK_STACK_TRANSITION_TYPE_SLIDE_LEFT</property>
        <child>
            <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <child>
                    <object class="GtkImage">
                        <property name="file">./assets/velvet.png</property>
                        <property name="pixel_size">256</property>
                    </object>
                </child>
                <child>
                    <object class="GtkAspectFrame">
                        <property name="obey-child">false</property>
                        <property name="ratio">4</property>
                        <child>
                            <object class="GtkDropDown" id="device_list">
                                <property name="model">
                                    <object class="GtkStringList">
                                    </object>
                                </property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkAspectFrame">
                        <property name="obey-child">false</property>
                        <property name="ratio">2</property>
                        <child>
                            <object class="GtkButton" id="btn_install">
                                <property name="label">Install</property>
                            </object>
                        </child>
                    </object>
                </child>
                <child>
                    <object class="GtkAspectFrame">
                        <child>
                            <object class="GtkButton" id="btn_about">
                                <property name="label">About</property>
                                <style>
                                    <class name="suggested-action" />
                                </style>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
        <child>
            <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="homogeneous">false</property>
                <property name="margin-top">10</property>
                <property name="margin-bottom">10</property>
                <child>
                    <object class="GtkImage" id="statusIMG">
                        <property name="file">./assets/working.png</property>
                        <property name="pixel_size">256</property>
                    </object>
                </child>
                <child>
                    <object class="GtkScrolledWindow" id="out_scroll">
                        <property name="propagate-natural-height">true</property>
                        <child>
                            <object class="GtkTextView" id="tv_log">
                                <property name="editable">false</property>
                                <property name="wrap-mode">GTK_WRAP_CHAR</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
    </object>
</interface>